<h1>Modify User Account Profile</h1>
<form action="/users/<%= user._id %>/update?_method=PUT" method="POST">
    <input type="text" name="first" value="<%= user.name.first %>" required>
    <input type="text" name="last" value="<%= user.name.last %>" required><br><br>
    <input type="email" name="email" value="<%= user.email %>" required><br><br>
    <input type="password" name="password" placeholder="Enter new or existing password" required><br><br>
    <button type="submit">Save Changes</button>
</form>
<p><a href="/users">Cancel and Return</a></p>